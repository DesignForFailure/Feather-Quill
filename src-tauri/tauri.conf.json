{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feather Quill",
  "version": "1.3.1",
  "identifier": "io.github.designforfailure.featherquill.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Feather Quill",
        "visible": false,
        "width": 1600,
        "height": 1000,
        "minWidth": 1360,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": null,
      "entitlements": "./Entitlements.plist",
      "infoPlist": "EditorialDocuments.plist"
    },
    "icon": [
      "icons/feather-quill/32x32.png",
      "icons/feather-quill/128x128.png",
      "icons/feather-quill/128x128@2x.png",
      "icons/feather-quill/icon.icns",
      "icons/feather-quill/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A local writing workspace for ideas, outlines, and manuscripts",
    "longDescription": "Feather Quill helps fiction writers go from outline to draft by providing a scaffolded writing environment where scene beats appear as expandable prompts.",
    "fileAssociations": [
      {
        "ext": ["kindling-review"],
        "name": "Feather Quill Review",
        "description": "Feather Quill editorial manuscript",
        "role": "Editor",
        "mimeType": "application/x-kindling-review",
        "exportedType": {
          "identifier": "io.github.designforfailure.featherquill.kindling-review",
          "conformsTo": ["public.json"]
        }
      },
      {
        "ext": ["kindling-feedback"],
        "name": "Feather Quill Feedback",
        "description": "Feather Quill editorial feedback",
        "role": "Editor",
        "mimeType": "application/x-kindling-feedback",
        "exportedType": {
          "identifier": "io.github.designforfailure.featherquill.kindling-feedback",
          "conformsTo": ["public.json"]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DesignForFailure/Feather-Quill/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "feather-quill"
}
